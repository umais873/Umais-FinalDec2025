name: Node.js CI/CD

on:
  push:        
    branches: ["main"]
  workflow_dispatch: 

jobs:
  build:
    name: Run Node.js Application
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Install dependencies
        run: npm install

      - name: Run Test Script
        run: npm test
